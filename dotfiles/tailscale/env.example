# Local-only Tailscale credentials.
# Installed to: ~/.config/tailscale/env  (mode 0600; never commit)
#
# Generate a reusable auth key in the Tailscale admin console:
#   https://login.tailscale.com/admin/settings/keys  (Settings > Keys > Generate auth key)
# Check "Reusable" (one key, all three lab nodes), set an expiry, and tag it so
# joined nodes inherit tag:homelab automatically (Settings > Keys > "Tags" dropdown,
# or set --advertise-tags on assertTailscale.sh — the key's own ACL permissions must
# allow the tag either way). Revoke old keys from the same Settings > Keys page.
#
# Fill in the value below, then open a new shell (or:
# set -a; source ~/.config/tailscale/env; set +a).

TAILSCALE_AUTHKEY=
