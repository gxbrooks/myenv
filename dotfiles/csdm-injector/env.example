# Local-only ServiceNow / csdm-injector credentials.
# Installed to: ~/.config/csdm-injector/env  (mode 0600; never commit)
#
# Fill in values, then open a new shell (or: set -a; source ~/.config/csdm-injector/env; set +a).
# Quote passwords that contain shell metacharacters: ( ) < > $ ? & etc.

SN_URL=https://YOUR_INSTANCE.service-now.com
SN_USER=
SN_PASSWORD='CHANGE_ME'

# From spark-observability vars/contexts/servicenow_sm_deploy.json after service-mapping/deploy:
SN_SM_POPULATE_TAGS_URI=
SN_SM_DISCOVER_URI=
SN_SM_ENSURE_TAG_CATEGORIES_URI=
SN_MID_SERVER_NAME=
